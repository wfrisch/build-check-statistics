[Unit]
Description=Build Check Statistics update (podman)

[Service]
Type=oneshot
StateDirectory=build_check_statistics
ExecStart=/usr/bin/podman run --rm --name bcs-update \
  -v %E/build_check_statistics.conf:/app/build_check_statistics.conf:ro,z \
  -v %S/build_check_statistics:/var/lib/build_check_statistics:z \
  localhost/build-check-statistics update -s
ExecStart=/usr/bin/podman run --rm --name bcs-deploy \
  -v %E/build_check_statistics.conf:/app/build_check_statistics.conf:ro,z \
  -v %S/build_check_statistics:/var/lib/build_check_statistics:z \
  localhost/build-check-statistics deploy
